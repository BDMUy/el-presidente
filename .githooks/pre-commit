#!/bin/sh

set -e

rojo() { printf '\033[31m%s\033[0m\n' "$1"; }
gris() { printf '\033[90m%s\033[0m\n' "$1"; }

archivos=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$archivos" ] && exit 0

problemas=0

NOMBRES='(^|/)\.env($|\.)|(^|/)\.npmrc$|(^|/)\.netrc$|(^|/)id_(rsa|ed25519)$|\.(pem|key|p12|pfx)$|(^|/)(secrets|credentials|service-account)[^/]*\.json$|\.(dump|sqlite3?)$'

for f in $archivos; do
  case "$f" in .env.example) continue ;; esac

  if printf '%s' "$f" | grep -qE "$NOMBRES"; then
    rojo "  ✗ $f"
    gris "    el nombre dice que esto no va al repositorio"
    problemas=$((problemas + 1))
  fi
done

PATRONES='-----BEGIN [A-Z ]*PRIVATE KEY-----
npg_[A-Za-z0-9]{16,}
AKIA[0-9A-Z]{16}
gh[pousr]_[A-Za-z0-9]{30,}
sk-ant-[A-Za-z0-9_-]{20,}
xox[baprs]-[A-Za-z0-9-]{10,}
postgres(ql)?://[^:/@[:space:]]+:[^@[:space:]]{8,}@
(SECRET|TOKEN|PASSWORD|PASSWD|API_?KEY|PRIVATE_?KEY|SALT|DATABASE_URL)[A-Z_]*[[:space:]]*[:=][[:space:]]*.?[A-Za-z0-9/+_-]{16,}'

for f in $archivos; do
  git show ":$f" 2>/dev/null | head -c 1024 | grep -qI . || continue

  printf '%s\n' "$PATRONES" | while IFS= read -r patron; do
    [ -z "$patron" ] && continue
    hallazgo=$(git show ":$f" 2>/dev/null | grep -nE -- "$patron" | head -2 || true)
    if [ -n "$hallazgo" ]; then
      rojo "  ✗ $f"
      printf '%s\n' "$hallazgo" | while IFS= read -r linea; do
        gris "    $(printf '%s' "$linea" | cut -c1-110)"
      done
      echo "x" >> "$(git rev-parse --git-dir)/HOOK_HALLAZGOS"
    fi
  done
done

marcador="$(git rev-parse --git-dir)/HOOK_HALLAZGOS"
if [ -f "$marcador" ]; then
  problemas=$((problemas + $(wc -l < "$marcador")))
  rm -f "$marcador"
fi

LIMITE=$((5 * 1024 * 1024))

for f in $archivos; do
  bytes=$(git cat-file -s "$(git rev-parse ":$f" 2>/dev/null)" 2>/dev/null || echo 0)
  if [ "$bytes" -gt "$LIMITE" ]; then
    rojo "  ✗ $f"
    gris "    pesa $((bytes / 1024 / 1024)) MB y el límite son 5"
    problemas=$((problemas + 1))
  fi
done

if [ "$problemas" -gt 0 ]; then
  echo ""
  rojo "Commit frenado: $problemas cosa(s) que no deberían entrar al repositorio."
  gris "Si estás seguro de que es un falso positivo: git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
