# Rankings (opcional)
#
# Sin esta variable el juego funciona completo: se puede jugar, compartir
# presidencias por link y acumular vitrina y logros. Lo único que no aparece es
# el ranking, porque las rutas responden 503 y la interfaz lo oculta.
#
# Es un DATABASE_URL de Postgres común, sin SDK de ningún proveedor: sirve
# Neon, Supabase, Railway o un VPS propio. Cambiar de proveedor es cambiar esta
# línea.
#
# NO puede llamarse NEXT_PUBLIC_*: solo la usa el servidor, que es el único que
# puede verificar un puntaje reproduciendo la partida. Si el navegador pudiera
# escribir en la tabla, la verificación no serviría de nada.

DATABASE_URL=


# Sal del hash de origen (recomendada en producción)
#
# Para limitar la frecuencia de envío hay que poder agrupar los pedidos por
# origen. Se guarda un hash del IP y nunca el IP, pero el espacio de IPv4 entero
# son cuatro mil millones de valores: un sha256 sin sal se revierte con una
# tabla en un rato, así que sin esta variable el hash no protege gran cosa.
#
# Cualquier cadena larga y al azar sirve. Cambiarla resetea las ventanas de
# límite en curso, nada más.

RANKING_SALT=


# Proxies de confianza delante de la aplicación (opcional, por defecto 1)
#
# El IP del cliente se lee contando desde el final de x-forwarded-for, porque
# un proxy agrega al final el IP de quien se le conectó y todo lo que está
# antes lo pudo escribir el propio cliente. Uno alcanza para Vercel y para un
# reverse proxy normal. Si además hay un CDN adelante, poner 2.

TRUSTED_PROXIES=


# Dirección pública del sitio (recomendada en producción)
#
# De acá cuelgan las URLs absolutas de los metadatos, y en particular la de la
# imagen de vista previa que se genera para cada presidencia compartida. Si no
# está, Next arma esa URL contra localhost y el link pegado en WhatsApp sale
# sin imagen, sin que falle nada visible.
#
# En Netlify se puede omitir: la plataforma define `URL` sola con la dirección
# del sitio y el código la usa como respaldo. Conviene ponerla igual, porque es
# la única forma de que el dominio propio —y no el *.netlify.app— sea el que
# aparece en la vista previa.
#
# Sin barra final: https://elpresidente.netlify.app

SITE_URL=


# Dónde está el código fuente (obligatoria si el sitio es público)

# El juego se publica bajo la AGPL v3, y su artículo 13 dice que si alguien
# corre una versión modificada en un servidor tiene que ofrecerle el código a
# quien la use. Con esta variable, el inicio muestra al pie un link al
# repositorio; sin ella no muestra nada, para no dejar un link roto.
#
# Es la única variable del proyecto que lleva NEXT_PUBLIC_ con razón: es una
# dirección pública que tiene que llegar al navegador, no una credencial.

NEXT_PUBLIC_SOURCE_URL=
